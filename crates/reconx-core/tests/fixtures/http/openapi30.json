{
  "openapi": "3.0.4",
  "info": {
    "title": "Owned API fixture",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.example.test/api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/users/{userId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "get": {
        "summary": "Read owned test user",
        "responses": {
          "200": {
            "description": "User data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "owner": {
            "type": "string"
          },
          "friend": {
            "$ref": "#/components/schemas/User"
          }
        }
      }
    }
  }
}